{
  "name": "mcp-cyber-tools",
  "version": "1.1.0",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "deploy:verify": "node scripts/deploy-verify.js",
    "qa:tier1": "node tests/smoke/automated-suite.js && node scripts/validate-tier1-results.js",
    "qa:regression": "node tests/tier3/regression-suite.js",
    "report:generate": "node scripts/generate-certification-report.js",
    "report:validate": "node scripts/validate-certification.js",
    "report:clean": "node scripts/generate-clean-rebuild-report.js",
    "test:validation": "node test-validation-engine.js",
    "test:predictions": "node test-prediction-engine.js",
    "test:patterns": "node test-pattern-engine.js",
    "test:comparator": "node test-comparator-engine.js",
    "delta": "node scripts/delta.js",
    "check:tools": "node scripts/validate.js",
    "gate": "node scripts/gate.js",
    "recommend": "node scripts/recommend.js",
    "certify": "npm run deploy:verify && npm run qa:tier1 && npm run qa:regression && npm run report:generate && npm run report:validate",
    "validate": "npm run certify && npm run report:clean",
    "intelligence:validate": "npm run test:validation"
  },
  "keywords": [],
  "author": "Cyber Tools Team",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "nodemailer": "^9.0.6",
    "zod": "^4.4.3"
  }
}
