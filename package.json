{
  "name": "mcp-cyber-tools",
  "version": "1.0.1",
  "type": "module",
  "main": "web/server.js",
  "scripts": {
    "start": "node web/server.js",
    "dev": "node web/server.js",
    "probe": "python scripts/sensor_probe.py",
    "validate": "python scripts/tool_validator.py",
    "assets": "python scripts/asset_manager.py --health",
    "trust": "python scripts/asset_builder.py",
    "test:detection": "python tests/detection_quality/run_all.py",
    "audit:detection": "python scripts/detection_quality.py",
    "gate": "python scripts/sprint_gate.py",
    "gate:full": "python scripts/sprint_gate.py --validate",
    "audit:portal": "python scripts/portal_field_audit.py",
    "audit:telegram": "python scripts/telegram_field_audit.py",
    "coverage": "python scripts/refresh_sensor_coverage.py",
    "coverage:auto": "python scripts/refresh_sensor_coverage.py --auto-validate",
    "logs:enable": "powershell -ExecutionPolicy Bypass -File scripts/enable_forensic_logs.ps1",
    "ioc:quality": "python scripts/ioc_quality.py",
    "audit:pipeline": "python scripts/pipeline_field_audit.py",
    "handoff": "python scripts/generate_handoff.py",
    "evidence:manifest": "python scripts/evidence_manifest.py",
    "audit:escape": "python scripts/portal_escape_audit.py",
    "db:mirror": "python scripts/sqlite_mirror.py",
    "db:verify": "python scripts/sqlite_mirror.py --verify"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "node-telegram-bot-api": "^0.61.0",
    "zod": "^4.4.3"
  }
}
