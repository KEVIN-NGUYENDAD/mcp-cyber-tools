# SentinelOps Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive credentials

# ================================================
# Telegram Bot Configuration
# ================================================
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Your personal Telegram chat ID (get from /start with bot)
TELEGRAM_CHAT_ID=your_chat_id_here

# ================================================
# Nessus Integration
# ================================================
# NESSUS_URL=https://your-nessus-server:8834
# NESSUS_API_KEY=your_api_key
# NESSUS_SECRET_KEY=your_secret_key

# ================================================
# GitHub Integration (if needed)
# ================================================
# GITHUB_TOKEN=your_github_token
# GITHUB_OWNER=your_github_owner
# GITHUB_REPO=your_repo_name

# ================================================
# Web API (web/server.js) - EXP-02
# ================================================
# Khoa cho moi route /api. KHONG dat -> /api tra 503 (fail-closed, co y).
# Sinh mot khoa: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=your_api_key_here
# Origin duoc phep goi cheo, ngan cach bang dau phay. Bo trong = khong origin ngoai nao.
# ALLOWED_ORIGINS=https://your-dashboard.example.com

# ================================================
# Application Settings
# ================================================
# STATE_DIR=state
# LOG_DIR=logs
# PORT=3000
