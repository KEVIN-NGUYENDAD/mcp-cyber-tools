# SentinelOps Credentials Configuration
# Copy this file to .env and fill in your credentials
# Never commit .env to version control

# NESSUS - Vulnerability Scanner
NESSUS_URL=https://localhost:8834
NESSUS_ACCESS_KEY=your-nessus-access-key
NESSUS_SECRET_KEY=your-nessus-secret-key

# PORKBUN - Domain Management
PORKBUN_API_KEY=your-porkbun-api-key
PORKBUN_SECRET_KEY=your-porkbun-secret-key

# VNETWORK - Web Application Protection
VNETWORK_API_TOKEN=your-vnetwork-api-token

# GITHUB - GitHub Integration (optional)
GITHUB_TOKEN=your-github-token
