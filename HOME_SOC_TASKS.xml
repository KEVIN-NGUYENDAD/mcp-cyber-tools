<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.3" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Date>2026-08-24T00:00:00</Date>
    <Author>HOME SOC</Author>
    <Description>HOME SOC Automation - Startup Initialization</Description>
    <URI>\HOME_SOC\Startup</URI>
  </RegistrationInfo>

  <Triggers>
    <LogonTrigger>
      <Enabled>true</Enabled>
      <UserId>S-1-5-18</UserId>
    </LogonTrigger>
  </Triggers>

  <Principals>
    <Principal id="LocalSystem">
      <UserId>S-1-5-18</UserId>
      <RunLevel>HighestAvailable</RunLevel>
    </Principal>
  </Principals>

  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <AllowHardTerminate>true</AllowHardTerminate>
    <StartWhenAvailable>true</StartWhenAvailable>
    <NetworkSettings>
      <Name>HOME_SOC_NETWORK</Name>
      <Id>HOME_SOC_NET</Id>
    </NetworkSettings>
    <IdleSettings>
      <Duration>PT1M</Duration>
      <WaitTimeout>PT1H</WaitTimeout>
      <StopOnIdleEnd>false</StopOnIdleEnd>
      <RestartOnIdle>false</RestartOnIdle>
    </IdleSettings>
  </Settings>

  <Actions Context="LocalSystem">
    <Exec>
      <Command>cmd.exe</Command>
      <Arguments>/c "C:\path\to\HOME_SOC_GOD_MODE.cmd"</Arguments>
      <WorkingDirectory>C:\path\to\mcp-cyber-tools</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
